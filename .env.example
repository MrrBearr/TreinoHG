# ═══════════════════════════════════════════════════════════════
# TreinoHG — Environment Variables
# ═══════════════════════════════════════════════════════════════

# ─── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI Provider: NVIDIA (primary for image/vision analysis) ──
# Get a key at: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# ─── AI Provider: TEXT_AI (primary for text/food estimation) ──
# Works with any OpenAI-compatible endpoint.
# Recommended: Groq (fast & free) — https://console.groq.com
TEXT_AI_API_KEY=
TEXT_AI_BASE_URL=https://api.groq.com/openai/v1
TEXT_AI_MODEL=llama-3.3-70b-versatile

# ─── App URL ──────────────────────────────────────────────────
# MUST be your production domain (for email links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
