# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://wtsdlfjtfromgtfeormn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# AI provider (OpenAI-compatible)
# Defaults to FreeModel.dev. Swap to https://api.openai.com/v1 to use OpenAI directly.
OPENAI_API_KEY=YOUR_FREEMODEL_API_KEY
OPENAI_BASE_URL=https://api.freemodel.dev/v1
OPENAI_MODEL=gpt-5.5

# Public site URL.
# IMPORTANT: in production this MUST be the Vercel/custom domain, e.g.
#   https://treinohg.vercel.app
# This URL is used for email confirmation links, OAuth callbacks, and
# magic-link redirects. Must match the "Site URL" set in the Supabase dashboard.
NEXT_PUBLIC_APP_URL=http://localhost:3000
