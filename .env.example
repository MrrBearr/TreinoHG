# ═══════════════════════════════════════════════════════════════
# TreinoHG — Environment Variables
# ═══════════════════════════════════════════════════════════════

# ─── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI Provider Chain (Gemini → OpenRouter → LLM7) ───────────
# The app tries providers in order. The first that responds wins.
# Configure as many or as few as you want — at least one is required.

# 1. PRIMARY: Google Gemini (3-key failover within Gemini itself).
#    Get free keys at: https://aistudio.google.com/apikey
GEMINI_API_KEY_1=your-first-gemini-key
GEMINI_API_KEY_2=your-second-gemini-key
GEMINI_API_KEY_3=your-third-gemini-key

# Optional Gemini model overrides
# GEMINI_MODEL_PRIMARY=gemini-2.5-pro
# GEMINI_MODEL_FAST=gemini-2.5-flash

# 2. SECONDARY: OpenRouter (OpenAI-compatible).
#    https://openrouter.ai — supports many models including free vision ones.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# 3. TERTIARY: LLM7 (free OpenAI-compatible proxy).
#    https://api.llm7.io
LLM7_API_KEY=
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_MODEL=gpt-4o-mini

# ─── App URL ──────────────────────────────────────────────────
# MUST be your production domain on Vercel (for email confirmation links).
# Locally this should be http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
