# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# =============================================================================
# AI providers
# -----------------------------------------------------------------------------
# Three independent channels, wired in lib/openai/client.ts:
#
#   VISION  : meal-photo analysis        -> NVIDIA NIM
#   TEXT    : food parsing / insights /  -> LLM7 (preferred) or TEXT_AI
#             coach answers / motivation    (fallback if LLM7 not set)
#   USDA    : nutrition lookup fallback  -> USDA FoodData Central
#
# TACO/TBCA is built into the codebase (lib/nutrition/taco.ts) and needs
# no env config.
# =============================================================================

# ---- VISION (NVIDIA) -------------------------------------------------------
# Used by /api/ai/analyze-photo. NVIDIA NIM is OpenAI-compatible.
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
# Optional overrides:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# ---- TEXT (LLM7 preferred, TEXT_AI fallback) ------------------------------
# LLM7 is tried first when both LLM7_API_KEY and LLM7_MODEL are set.
LLM7_API_KEY=YOUR_LLM7_API_KEY
LLM7_MODEL=YOUR_LLM7_MODEL_ID

# Generic OpenAI-compatible text fallback. Used only when LLM7 is not fully
# configured. Set all three to enable.
TEXT_AI_API_KEY=YOUR_TEXT_AI_API_KEY
TEXT_AI_BASE_URL=https://your-text-provider.example.com/v1
TEXT_AI_MODEL=YOUR_TEXT_MODEL_ID

# ---- NUTRITION (USDA FoodData Central) ------------------------------------
# Optional. When set, the resolver falls back to USDA for foods not in TACO.
# Free signup: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=YOUR_USDA_API_KEY

# ---- Reserved -------------------------------------------------------------
# GEMINI_API_KEY_2 is recognised in the production env but not currently
# wired to any code path. Reserved for a future text-AI fallback.

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
